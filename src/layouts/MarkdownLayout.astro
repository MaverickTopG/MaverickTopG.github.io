---
import PageLayout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import founderImage from '~/assets/images/blog-founder.png';
import journeysImage from '~/assets/images/blog-journeys.png';
import reportingImage from '~/assets/images/blog-reporting.png';

const { title, relatedPosts = [], frontmatter = {} } = Astro.props;
const metadata = title ? { title } : undefined;
const currentPath = new URL(Astro.url).pathname;
const isBlogPost = currentPath.startsWith('/blog/') && currentPath !== '/blog/';

const fallbackPosts = [
  {
    title: 'How I Built NexoLink: A Founder Story in 5 Minutes',
    href: '/blog/nexolink-founder-story',
    excerpt:
      'Why NexoLink exists, the principles behind the product, and the moments that shaped the volunteer experience.',
    image: founderImage,
    imageAlt: 'Team working together',
  },
  {
    title: 'Designing Volunteer Journeys That Stick',
    href: '/blog/designing-volunteer-journeys',
    excerpt: 'From discovery to recognition, learn how we craft a volunteer flow that keeps engagement strong.',
    image: journeysImage,
    imageAlt: 'Volunteer experience highlights',
  },
  {
    title: 'Impact Reporting That Boards Actually Trust',
    href: '/blog/impact-reporting-that-builds-trust',
    excerpt: 'Clean data, fast exports, and visual clarity turn volunteer hours into stories your partners can act on.',
    image: reportingImage,
    imageAlt: 'Product development work',
  },
];

const frontmatterRelated = frontmatter.relatedPosts ?? [];
const filteredFallbackPosts = fallbackPosts.filter((post) => post.href !== currentPath);
const resolvedRelatedPosts = relatedPosts.length
  ? relatedPosts
  : frontmatterRelated.length
    ? frontmatterRelated
    : isBlogPost
      ? (filteredFallbackPosts.length ? filteredFallbackPosts : fallbackPosts).slice(0, 4)
      : [];
---

<PageLayout metadata={metadata}>
  <section class="mx-auto w-full max-w-3xl px-4 py-12 sm:py-16">
    {title ? <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">{title}</h1> : null}
    <article class="prose prose-lg mt-6 max-w-none text-gray-700 dark:prose-invert dark:text-gray-300">
      <slot />
    </article>
  </section>

  {
    isBlogPost && resolvedRelatedPosts.length ? (
      <section class="border-t border-gray-200 py-12 dark:border-slate-800">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6">
          <div class="mb-8 flex flex-col lg:flex-row lg:justify-between">
            <div class="md:max-w-sm">
              <h2 class="mb-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Related Posts</h2>
              <a class="block text-muted transition hover:text-primary dark:text-slate-400" href="/blog">
                View All Posts »
              </a>
            </div>
          </div>
          <div class="grid justify-center justify-items-center gap-6 text-center sm:grid-cols-2 lg:grid-cols-4">
            {resolvedRelatedPosts.map((post) => (
              <article class="mb-6 max-w-sm transition">
                <div class="relative mb-6 overflow-hidden rounded bg-gray-400 shadow-lg dark:bg-slate-700 aspect-square">
                  <a href={post.href} class="block h-full w-full">
                    <Image
                      class="h-full w-full object-cover object-center"
                      src={post.image}
                      alt={post.imageAlt}
                      widths={[768, 1024, 1600, 2048, 2560, 3840]}
                      sizes="100vw"
                    />
                  </a>
                </div>
                <h3 class="mb-2 text-xl font-bold leading-tight text-gray-900 dark:text-slate-300 sm:text-2xl">
                  <a class="inline-block transition hover:text-primary dark:hover:text-blue-700" href={post.href}>
                    {post.title}
                  </a>
                </h3>
                {post.excerpt && <p class="text-lg text-muted dark:text-slate-400">{post.excerpt}</p>}
              </article>
            ))}
          </div>
        </div>
      </section>
    ) : null
  }
</PageLayout>
