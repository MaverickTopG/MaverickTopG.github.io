---
import Image from '~/components/common/Image.astro';
import type { ImageProps } from '~/utils/images-optimization';

export interface Props {
  image: ImageProps;
}

const { image } = Astro.props;
---

<div class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white/70 shadow-lg shadow-slate-200/60 dark:border-white/10 dark:bg-slate-900/40">
  <div class="aspect-[30/13.25] w-full">
    <Image class="h-full w-full object-contain" {...image} />
  </div>
</div>
