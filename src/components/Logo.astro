---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-2">
  <img src="/new_icon_square.png" alt={SITE?.name || 'NexoLink'} class="h-9 w-9 rounded-xl" />
  <span
    class="text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
  >
    {SITE?.name}
  </span>
</span>
