---
import Layout from '~/layouts/Layout.astro';

const firebaseConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY || '',
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN || '',
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID || '',
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID || '',
  measurementId: import.meta.env.PUBLIC_FIREBASE_MEASUREMENT_ID || '',
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET || '',
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID || '',
};

const metadata = {
  title: 'Create Admin Account',
};
---

<Layout metadata={metadata}>
  <section class="min-h-screen bg-slate-50 dark:bg-slate-950">
    <div class="mx-auto flex min-h-screen w-full max-w-2xl items-center px-4 py-16">
      <div class="w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-200/30 dark:border-white/10 dark:bg-slate-900/80">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">Admin setup</p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Create your NexoLink workspace</h1>
          <p class="mt-2 text-sm text-gray-600 dark:text-slate-400">
            Enter your organization details to finish setup. We will generate a secure join code for your team.
          </p>
        </div>

        <div class="mb-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-100" data-checkout-status hidden></div>

        <form class="space-y-5" data-create-org-form>
          <div>
            <label class="mb-2 block text-sm font-semibold text-gray-700 dark:text-slate-200">Organization name</label>
            <input
              type="text"
              name="organization"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              placeholder="NexoLink Community Center"
              required
            />
          </div>
          <div>
            <label class="mb-2 block text-sm font-semibold text-gray-700 dark:text-slate-200">Email</label>
            <input
              type="email"
              name="email"
              data-email-input
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              placeholder="admin@nexolink.org"
              required
            />
          </div>
          <div>
            <label class="mb-2 block text-sm font-semibold text-gray-700 dark:text-slate-200">Password</label>
            <div class="relative">
              <input
                type="password"
                name="password"
                data-password-input
                class="w-full rounded-xl border border-slate-200 px-4 py-3 pr-11 text-sm text-gray-900 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
                placeholder="Create a secure password"
                minlength="8"
                required
              />
              <button
                type="button"
                data-toggle-password
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-white"
                aria-label="Show password"
              >
                <svg
                  data-password-show
                  class="h-5 w-5"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <svg
                  data-password-hide
                  class="hidden h-5 w-5"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.6 21.6 0 0 1 5.06-6.06" />
                  <path d="M9.88 9.88A3 3 0 0 0 12 15a3 3 0 0 0 2.12-.88" />
                  <path d="M1 1l22 22" />
                  <path d="M10.58 5.08A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.6 21.6 0 0 1-4.19 5.19" />
                </svg>
              </button>
            </div>
          </div>
          <button
            type="submit"
            class="w-full rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/30 transition hover:bg-primary/90"
            data-submit-button
          >
            Create workspace
          </button>
        </form>
        <p class="mt-6 text-center text-xs text-gray-500 dark:text-slate-400">
          By creating an account, you confirm your Stripe checkout and agree to NexoLink terms.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ firebaseConfig }}>
  const statusEl = document.querySelector('[data-checkout-status]');
  const form = document.querySelector('[data-create-org-form]');
  const submitButton = document.querySelector('[data-submit-button]');
  const emailInput = document.querySelector('[data-email-input]');
  const passwordInput = document.querySelector('[data-password-input]');
  const togglePasswordButton = document.querySelector('[data-toggle-password]');
  const toggleIconShow = document.querySelector('[data-password-show]');
  const toggleIconHide = document.querySelector('[data-password-hide]');

  const setStatus = (message, type = 'info') => {
    if (!statusEl) return;
    if (!message) {
      statusEl.hidden = true;
      return;
    }
    statusEl.hidden = false;
    statusEl.textContent = message;
    statusEl.dataset.type = type;
  };

  const params = new URLSearchParams(window.location.search);
  const sessionId = params.get('session_id');
  const checkoutStatus = params.get('checkout');

  const redirectToPricing = () => {
    window.location.replace('/pricing');
  };

  if (checkoutStatus === 'cancel' || !sessionId) {
    redirectToPricing();
    return;
  }

  if (togglePasswordButton && passwordInput) {
    togglePasswordButton.addEventListener('click', () => {
      const isHidden = passwordInput.type === 'password';
      passwordInput.type = isHidden ? 'text' : 'password';
      toggleIconShow?.classList.toggle('hidden', !isHidden);
      toggleIconHide?.classList.toggle('hidden', isHidden);
      togglePasswordButton.setAttribute(
        'aria-label',
        isHidden ? 'Hide password' : 'Show password'
      );
    });
  }

  const lockEmailInput = (email) => {
    if (!emailInput || !email) return;
    emailInput.value = email;
    emailInput.readOnly = true;
    emailInput.setAttribute('aria-readonly', 'true');
    emailInput.classList.add('cursor-not-allowed', 'bg-slate-100', 'dark:bg-slate-800');
    const notify = () =>
      setStatus('This email is required for billing verification and cannot be changed.', 'info');
    emailInput.addEventListener('click', notify);
    emailInput.addEventListener('focus', notify);
  };

  const loadCheckoutEmail = async () => {
    if (!sessionId) return;
    try {
      const response = await fetch(`/api/checkoutSession?session_id=${encodeURIComponent(sessionId)}`);
      const payload = await response.json();
      if (response.ok && payload?.email) {
        lockEmailInput(payload.email);
      }
    } catch (error) {
      console.warn('Unable to lock billing email', error);
    }
  };

  loadCheckoutEmail();

  const loadFirebaseSdk = async () => {
    if (!firebaseConfig || !firebaseConfig.apiKey || !firebaseConfig.authDomain || !firebaseConfig.projectId) {
      throw new Error('Firebase config is missing.');
    }
    if (window.firebase?.apps?.length) {
      return window.firebase.auth();
    }
    const loadScript = (src) =>
      new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    await loadScript('https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js');
    await loadScript('https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js');
    window.firebase.initializeApp(firebaseConfig);
    return window.firebase.auth();
  };

  const setLoading = (isLoading) => {
    if (!submitButton) return;
    submitButton.disabled = isLoading;
    submitButton.classList.toggle('opacity-70', isLoading);
    submitButton.setAttribute('aria-busy', isLoading ? 'true' : 'false');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setStatus('');
    setLoading(true);

    const formData = new FormData(form);
    const organizationName = String(formData.get('organization') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const password = String(formData.get('password') || '');

    if (!organizationName || !email || !password) {
      setStatus('Please complete all fields to continue.', 'warning');
      setLoading(false);
      return;
    }
    if (password.length < 8) {
      setStatus('Password must be at least 8 characters.', 'warning');
      setLoading(false);
      return;
    }
    if (/\s/.test(password)) {
      setStatus('Password cannot contain spaces.', 'warning');
      setLoading(false);
      return;
    }

    try {
      const auth = await loadFirebaseSdk();
      let userCredential = null;

      try {
        userCredential = await auth.createUserWithEmailAndPassword(email, password);
      } catch (error) {
        if (error?.code === 'auth/email-already-in-use') {
          setStatus('An account with this email already exists. Please sign in to finish setup.', 'warning');
          return;
        }
        if (error?.code === 'auth/invalid-email' || error?.code === 'auth/invalid-credential') {
          setStatus('Please use a valid email and password to create your account.', 'warning');
          return;
        }
        if (error?.code === 'auth/weak-password') {
          setStatus('Please choose a stronger password (at least 8 characters).', 'warning');
          return;
        }
        throw error;
      }

      const user = userCredential?.user;
      if (!user) throw new Error('Unable to create account.');

      const idToken = await user.getIdToken();
      const response = await fetch('/api/createOrganization', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${idToken}`,
        },
        body: JSON.stringify({ organizationName, sessionId }),
      });

      const payload = await response.json();
      if (!response.ok) {
        throw new Error(payload?.error || 'Unable to create organization.');
      }

      if (payload?.organizationCode) {
        localStorage.setItem('nexolink_org_code', payload.organizationCode);
      }
      if (payload?.organizationId) {
        localStorage.setItem('nexolink_org_id', payload.organizationId);
      }
      localStorage.setItem('nexolink_org_name', organizationName);

      window.location.assign('/admin/');
    } catch (error) {
      console.error('[Create Org] Error', error);
      setStatus(error?.message || 'Unable to create your account. Please try again.', 'error');
    } finally {
      setLoading(false);
    }
  });
</script>
