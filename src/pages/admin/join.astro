---
import Layout from '~/layouts/Layout.astro';

const firebaseConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY || '',
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN || '',
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID || '',
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID || '',
  measurementId: import.meta.env.PUBLIC_FIREBASE_MEASUREMENT_ID || '',
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET || '',
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID || '',
};

const metadata = {
  title: 'Join Organization',
};
---

<Layout metadata={metadata}>
  <section class="min-h-screen bg-slate-50 dark:bg-slate-950">
    <div class="mx-auto flex min-h-screen w-full max-w-2xl items-center px-4 py-16">
      <div class="w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-200/30 dark:border-white/10 dark:bg-slate-900/80">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-primary">Join an organization</p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Enter your team code</h1>
          <p class="mt-2 text-sm text-gray-600 dark:text-slate-400">
            Use the 6-character code from your admin to join their NexoLink workspace.
          </p>
        </div>

        <div class="mb-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-100" data-join-status hidden></div>

        <form class="space-y-5" data-join-org-form>
          <div>
            <label class="mb-2 block text-sm font-semibold text-gray-700 dark:text-slate-200">Organization code</label>
            <input
              type="text"
              name="code"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm uppercase tracking-[0.2em] text-gray-900 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              placeholder="ABC123"
              maxlength="6"
              required
            />
          </div>
          <div>
            <label class="mb-2 block text-sm font-semibold text-gray-700 dark:text-slate-200">Email</label>
            <input
              type="email"
              name="email"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              placeholder="volunteer@nexolink.org"
              required
            />
          </div>
          <div>
            <label class="mb-2 block text-sm font-semibold text-gray-700 dark:text-slate-200">Password</label>
            <input
              type="password"
              name="password"
              class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
              placeholder="Use your account password"
              minlength="8"
              required
            />
          </div>
          <button
            type="submit"
            class="w-full rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-primary/30 transition hover:bg-primary/90"
            data-submit-button
          >
            Join workspace
          </button>
        </form>
        <p class="mt-6 text-center text-xs text-gray-500 dark:text-slate-400">
          Need an admin account? <a href="/admin/create" class="font-semibold text-primary hover:text-primary/80">Create one here</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ firebaseConfig }}>
  const statusEl = document.querySelector('[data-join-status]');
  const form = document.querySelector('[data-join-org-form]');
  const submitButton = document.querySelector('[data-submit-button]');

  const setStatus = (message) => {
    if (!statusEl) return;
    if (!message) {
      statusEl.hidden = true;
      return;
    }
    statusEl.hidden = false;
    statusEl.textContent = message;
  };

  const loadFirebaseSdk = async () => {
    if (!firebaseConfig || !firebaseConfig.apiKey || !firebaseConfig.authDomain || !firebaseConfig.projectId) {
      throw new Error('Firebase config is missing.');
    }
    if (window.firebase?.apps?.length) {
      return window.firebase.auth();
    }
    const loadScript = (src) =>
      new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    await loadScript('https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js');
    await loadScript('https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js');
    window.firebase.initializeApp(firebaseConfig);
    return window.firebase.auth();
  };

  const setLoading = (isLoading) => {
    if (!submitButton) return;
    submitButton.disabled = isLoading;
    submitButton.classList.toggle('opacity-70', isLoading);
    submitButton.setAttribute('aria-busy', isLoading ? 'true' : 'false');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setStatus('');
    setLoading(true);

    const formData = new FormData(form);
    const accessCode = String(formData.get('code') || '').trim().toUpperCase();
    const email = String(formData.get('email') || '').trim();
    const password = String(formData.get('password') || '');

    if (accessCode.length !== 6 || !email || !password) {
      setStatus('Please enter the 6-character code and your account credentials.');
      setLoading(false);
      return;
    }

    try {
      const auth = await loadFirebaseSdk();
      let userCredential = null;

      try {
        userCredential = await auth.signInWithEmailAndPassword(email, password);
      } catch (error) {
        if (error?.code === 'auth/user-not-found') {
          userCredential = await auth.createUserWithEmailAndPassword(email, password);
        } else {
          throw error;
        }
      }

      const user = userCredential?.user;
      if (!user) throw new Error('Unable to sign in.');

      const idToken = await user.getIdToken();
      const response = await fetch('/api/joinOrganization', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${idToken}`,
        },
        body: JSON.stringify({ accessCode }),
      });

      const payload = await response.json();
      if (!response.ok) {
        throw new Error(payload?.error || 'Unable to join organization.');
      }

      if (payload?.organizationCode) {
        localStorage.setItem('nexolink_org_code', payload.organizationCode);
      }
      if (payload?.organizationId) {
        localStorage.setItem('nexolink_org_id', payload.organizationId);
      }
      if (payload?.organizationName) {
        localStorage.setItem('nexolink_org_name', payload.organizationName);
      }

      window.location.assign('/admin/');
    } catch (error) {
      console.error('[Join Org] Error', error);
      setStatus(error?.message || 'Unable to join organization. Please try again.');
    } finally {
      setLoading(false);
    }
  });
</script>
