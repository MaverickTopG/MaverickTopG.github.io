---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Pricing"
    title="Choose a plan that powers your volunteer impact."
    subtitle="Pick the subscription that fits your workspace. All plans include full admin access, analytics, and effortless onboarding. Includes a 14-day free trial."
  />

  <Prices
    title="Plans for every mission"
    subtitle="Only pay for what your organization needs."
    prices={[
      {
        title: 'Monthly',
        planKey: 'monthly',
        subtitle: 'Flexible month-to-month access',
        billing: 'monthly',
        price: 5,
        period: 'per month',
        items: [
          {
            description: 'Full admin portal access',
          },
          {
            description: 'Unlimited volunteer records',
          },
          {
            description: 'Automated analytics & reports',
          },
        ],
        callToAction: {
          text: 'Start Monthly',
          'data-plan-key': 'monthly',
          'data-plan-billing': 'monthly',
        },
      },
      {
        title: 'Yearly',
        planKey: 'yearly',
        subtitle: 'Save 17% with annual billing',
        billing: 'yearly',
        price: 50,
        period: 'per year',
        items: [
          {
            description: 'Everything in Monthly',
          },
          {
            description: 'Priority roadmap requests',
          },
          {
            description: 'Annual compliance report bundle',
          },
        ],
        callToAction: {
          text: 'Start Yearly',
          'data-plan-key': 'yearly',
          'data-plan-billing': 'yearly',
        },
        hasRibbon: true,
        ribbonTitle: 'Save 17%',
      },
      {
        title: 'School',
        planKey: 'school',
        subtitle: 'Built for schools and districts',
        billing: 'monthly',
        price: 5,
        period: 'per month',
        items: [
          {
            description: 'Roster uploads and student-friendly sign-ins',
          },
          {
            description: 'Compliance-ready reports and exports',
          },
          {
            description: 'Centralized reporting for campuses',
          },
        ],
        callToAction: {
          text: 'Start School Plan',
          'data-plan-key': 'school',
          'data-plan-billing': 'monthly',
        },
      },
      {
        title: 'School Annual',
        planKey: 'school',
        subtitle: 'Save 17% with annual billing',
        billing: 'yearly',
        price: 50,
        period: 'per year',
        items: [
          {
            description: 'Roster uploads and student-friendly sign-ins',
          },
          {
            description: 'Compliance-ready reports and exports',
          },
          {
            description: 'Centralized reporting for campuses',
          },
        ],
        callToAction: {
          text: 'Start School Annual',
          'data-plan-key': 'school',
          'data-plan-billing': 'yearly',
        },
        hasRibbon: true,
        ribbonTitle: 'Save 17%',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute -top-24 right-[-5%] h-56 w-56 rounded-full bg-primary/10 blur-3xl animate-float-slow"></div>
      <div class="absolute -bottom-32 left-[-5%] h-64 w-64 rounded-full bg-accent/10 blur-3xl animate-pulse-soft"></div>
    </Fragment>
  </Prices>

  <FAQs
    title="Pricing FAQs"
    subtitle="Quick answers to the most common plan questions."
    columns={1}
    items={[
      {
        title: 'What is included with every plan?',
        description:
          'All plans include full admin portal access, analytics, and effortless onboarding so your team can start quickly.',
      },
      {
        title: 'Is there a free trial?',
        description: 'Yes. Every plan includes a 14-day free trial before billing begins.',
      },
      {
        title: 'Who is the School plan for?',
        description:
          'The School plan is designed for schools and districts, with roster uploads, student-friendly sign-ins, and compliance-ready reports.',
      },
    ]}
  />

  <CallToAction
    title="Ready to unlock the admin experience?"
    subtitle="Start your free trial and bring volunteer stats, approvals, and impact reporting into one calm command center."
    actions={[
      {
        variant: 'primary',
        text: 'Start a plan',
        'data-plan-key': 'monthly',
        'data-plan-billing': 'monthly',
      },
    ]}
  />
</Layout>
