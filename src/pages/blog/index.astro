---
import PageLayout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';

import founderImage from '~/assets/images/blog-founder.png';
import journeysImage from '~/assets/images/blog-journeys.png';
import reportingImage from '~/assets/images/blog-reporting.png';

const posts = [
  {
    title: 'How I Built NexoLink: A Founder Story in 5 Minutes',
    href: '/blog/nexolink-founder-story',
    date: 'Dec 20, 2025',
    author: 'Ayansh Singh',
    category: 'Founder story',
    excerpt:
      'Why NexoLink exists, the principles behind the product, and the moments that shaped the volunteer experience.',
    tags: ['nexolink', 'product', 'founder'],
    image: founderImage,
    imageAlt: 'Team working together',
  },
  {
    title: 'Designing Volunteer Journeys That Stick',
    href: '/blog/designing-volunteer-journeys',
    date: 'Dec 27, 2025',
    author: 'NexoLink Team',
    category: 'Design',
    excerpt:
      'From discovery to recognition, learn how we craft a volunteer flow that keeps engagement strong.',
    tags: ['design', 'volunteers', 'experience'],
    image: journeysImage,
    imageAlt: 'Volunteer experience highlights',
  },
  {
    title: 'Impact Reporting That Boards Actually Trust',
    href: '/blog/impact-reporting-that-builds-trust',
    date: 'Jan 3, 2026',
    author: 'NexoLink Team',
    category: 'Reporting',
    excerpt:
      'Clean data, fast exports, and visual clarity turn volunteer hours into stories your partners can act on.',
    tags: ['reporting', 'analytics', 'impact'],
    image: reportingImage,
    imageAlt: 'Product development work',
  },
];
---

<PageLayout metadata={{ title: 'NexoLink | Blog', ignoreTitleTemplate: true }}>
  <section class="mx-auto w-full max-w-6xl px-4 py-12 sm:py-16">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">The Blog</h1>
      <p class="mt-3 text-lg text-muted dark:text-slate-300">
        Updates, product notes, and stories from the NexoLink team.
      </p>
    </div>

    <div class="mt-12 space-y-10">
      {
        posts.map((post) => (
          <article class="grid gap-8 md:grid-cols-2 md:items-center">
            <a class="block h-64 overflow-hidden rounded-2xl shadow-lg" href={post.href}>
              <Image
                class="h-full w-full object-cover"
                src={post.image}
                alt={post.imageAlt}
                widths={[768, 1024, 1600, 2048, 2560, 3840]}
                sizes="100vw"
              />
            </a>
            <div>
              <div class="flex flex-wrap items-center gap-2 text-sm text-muted dark:text-slate-400">
                <span>{post.date}</span>
                <span>•</span>
                <span>{post.author}</span>
                <span>•</span>
                <span>{post.category}</span>
              </div>
              <h2 class="mt-3 text-2xl font-semibold text-gray-900 dark:text-white">
                <a class="hover:text-primary" href={post.href}>
                  {post.title}
                </a>
              </h2>
              <p class="mt-3 text-base text-muted dark:text-slate-300">{post.excerpt}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {post.tags.map((tag) => (
                  <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-slate-800 dark:text-slate-200">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</PageLayout>
