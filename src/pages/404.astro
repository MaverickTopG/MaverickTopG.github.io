---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Page not found',
};
---

<Layout metadata={metadata}>
  <section class="py-20">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-muted">404</p>
      <h1 class="mt-3 text-3xl font-bold text-heading sm:text-4xl">This page is off the map.</h1>
      <p class="mt-4 text-muted">
        The link you followed doesn’t exist anymore. Head back to the NexoLink home page.
      </p>
      <div class="mt-8 flex justify-center">
        <a class="btn-primary" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Layout>
