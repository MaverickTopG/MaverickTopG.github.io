{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "volunteer-dashboard (2)/nexolink-landing-page/dist",
    "cleanUrls": true,
    "predeploy": [
      "npm run build"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      },
      {
        "source": "/api/checkout",
        "function": "createCheckout"
      },
      {
        "source": "/api/createOrganization",
        "function": "createOrganization"
      },
      {
        "source": "/api/joinOrganization",
        "function": "joinOrganization"
      },
      {
        "source": "/api/portal",
        "function": "createPortal"
      },
      {
        "source": "/api/checkoutSession",
        "function": "getCheckoutSession"
      },
      {
        "source": "/api/invoices",
        "function": "listInvoices"
      },
      {
        "source": "/api/subscriptions",
        "function": "listSubscriptions"
      },
      {
        "source": "/api/cancelSubscription",
        "function": "cancelSubscription"
      },
      {
        "source": "/api/webhook",
        "function": "stripeWebhook"
      },
      {
        "source": "/api/stripe",
        "function": "stripeWebhook"
      },
      {
        "source": "/api/issueAdminQr",
        "function": "issueAdminQr"
      },
      {
        "source": "/api/purgeEmail",
        "function": "purgeEmail"
      }
    ]
  }
}
