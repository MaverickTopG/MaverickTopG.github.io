{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/signup.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/api/checkout",
        "function": "createCheckout"
      },
      {
        "source": "/api/portal",
        "function": "createPortal"
      },
      {
        "source": "/api/checkoutSession",
        "function": "getCheckoutSession"
      },
      {
        "source": "/api/invoices",
        "function": "listInvoices"
      },
      {
        "source": "/api/subscriptions",
        "function": "listSubscriptions"
      },
      {
        "source": "/api/cancelSubscription",
        "function": "cancelSubscription"
      },
      {
        "source": "/api/stripe",
        "function": "stripeWebhook"
      },
      {
        "source": "/api/issueAdminQr",
        "function": "issueAdminQr"
      }
    ]
  }
}
