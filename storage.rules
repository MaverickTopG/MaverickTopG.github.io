rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Rely on custom claims from token.
    // 'paid' is true for paying org members or subdmins.
    // 'admin' or 'sub_admin' flags are set by Cloud Functions.
    function hasPaidAccess() {
      return isSignedIn() && (request.auth.token.paid == true || request.auth.token.grandfathered == true);
    }

    function hasFullAccess() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.sub_admin == true || 
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super-admin'
      );
    }

    // Check if path's orgId corresponds to auth token org claims.
    function orgMatchesClaim(pathOrgId) {
      return isSignedIn() && (
        pathOrgId == request.auth.token.orgId ||
        pathOrgId == request.auth.token.organizationId ||
        pathOrgId.matches('subadmin_' + (request.auth.token.orgId ? request.auth.token.orgId : '---') + '_.*') ||
        pathOrgId.matches('subadmin_' + (request.auth.token.organizationId ? request.auth.token.organizationId : '---') + '_.*')
      );
    }

    function orgMatches(pathOrgId) {
      return orgMatchesClaim(pathOrgId);
    }

    // Messaging attachments should be available to signed-in org participants.
    // Scope and org isolation is enforced by orgMatches/hasFullAccess checks.
    function planAllowsMessaging() {
      return isSignedIn();
    }

    function planAllowsEvents() {
      return hasPaidAccess() || hasFullAccess();
    }

    match /messages/{orgId}/{threadId}/{fileName} {
      // Messaging attachments must work for authenticated portal users.
      // Scope and recipient restrictions are enforced at Firestore message docs.
      allow read, write: if isSignedIn() && planAllowsMessaging();
    }

    match /events/{orgId}/{fileName} {
      allow read, write: if isSignedIn()
        && (hasFullAccess() || orgMatches(orgId))
        && planAllowsEvents();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
