rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasPaidAccess() {
      return isSignedIn() && request.auth.token.paid == true;
    }

    function userOrgDoc() {
      return get(/databases/$(database)/documents/user_organizations/$(request.auth.uid));
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && userOrgDoc().exists()
        && (
          userOrgDoc().data.org_id == orgId ||
          userOrgDoc().data.orgId == orgId ||
          userOrgDoc().data.organization_id == orgId ||
          userOrgDoc().data.organizationId == orgId
        );
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || hasPaidAccess());
      allow update: if isSignedIn() && (request.auth.uid == userId || hasPaidAccess());
      allow delete: if hasPaidAccess();
    }

    match /user_organizations/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || hasPaidAccess());
      allow update: if isSignedIn() && (request.auth.uid == userId || hasPaidAccess());
      allow delete: if hasPaidAccess();
    }

    match /user_organizations/{documentId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.user_id || hasPaidAccess());
      allow create, update, delete: if hasPaidAccess();
    }

    match /volunteer_logs/{document=**} {
      allow read, write: if hasPaidAccess();
    }

    match /program_templates/{document=**} {
      allow read, write: if hasPaidAccess();
    }

    match /report_schedules/{document=**} {
      allow read, write: if hasPaidAccess();
    }

    match /volunteer_organizations/{orgId} {
      allow read, update: if hasPaidAccess() || isOrgMember(orgId);
      allow create, delete: if hasPaidAccess();
    }

    match /organizations/{orgId} {
      allow read, update: if hasPaidAccess() || isOrgMember(orgId);
      allow create, delete: if hasPaidAccess();
    }

    match /orgs/{orgId} {
      allow read, update: if hasPaidAccess() || isOrgMember(orgId);
      allow create, delete: if hasPaidAccess();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
