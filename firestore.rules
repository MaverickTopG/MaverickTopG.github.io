rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasPaidAccess() {
      return isSignedIn() && request.auth.token.get('paid', false) == true;
    }

    function hasGrandfatheredAccess() {
      return isSignedIn() && request.auth.token.get('grandfathered', false) == true;
    }

    function hasFullAccess() {
      return hasPaidAccess() || hasGrandfatheredAccess();
    }

    function userOrgDoc() {
      return get(/databases/$(database)/documents/user_organizations/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function orgDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId));
    }

    function orgAdminDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/orgAdmins/$(request.auth.uid));
    }

    function isOrgAdmin(orgId) {
      return isSignedIn() && orgAdminDoc(orgId).data != null;
    }

    function docOrgId(data) {
      return data.orgId
        || data.org_id
        || data.organization_id
        || data.organizationId
        || data.linked_org_id
        || data.linkedOrgId
        || null;
    }

    function userOrgId() {
      return (userOrgDoc().exists()
        ? (
          userOrgDoc().data.org_id
          || userOrgDoc().data.orgId
          || userOrgDoc().data.organization_id
          || userOrgDoc().data.organizationId
          || userOrgDoc().data.linked_org_id
          || userOrgDoc().data.linkedOrgId
        )
        : null)
        || (userProfile().exists()
          ? (
            userProfile().data.org_id
            || userProfile().data.orgId
            || userProfile().data.organization_id
            || userProfile().data.organizationId
            || userProfile().data.linked_org_id
            || userProfile().data.linkedOrgId
          )
          : null);
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && (
          (userOrgDoc().exists()
            && (
              userOrgDoc().data.org_id == orgId ||
              userOrgDoc().data.orgId == orgId ||
              userOrgDoc().data.organization_id == orgId ||
              userOrgDoc().data.organizationId == orgId ||
              userOrgDoc().data.linked_org_id == orgId ||
              userOrgDoc().data.linkedOrgId == orgId
            ))
          || (userProfile().exists()
            && (
              userProfile().data.org_id == orgId ||
              userProfile().data.orgId == orgId ||
              userProfile().data.organization_id == orgId ||
              userProfile().data.organizationId == orgId ||
              userProfile().data.linked_org_id == orgId ||
              userProfile().data.linkedOrgId == orgId
            ))
        );
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || hasFullAccess());
      allow update: if isSignedIn() && (request.auth.uid == userId || hasFullAccess());
      allow delete: if hasFullAccess();

      match /personalLogs/{logId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && request.resource.data.userId == userId;
        allow update, delete: if false;
      }
    }

    match /user_organizations/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSignedIn() && (request.auth.uid == userId || hasFullAccess());
      allow update: if isSignedIn() && (request.auth.uid == userId || hasFullAccess());
      allow delete: if hasFullAccess();
    }

    match /user_organizations/{documentId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.user_id || hasFullAccess());
      allow create, update, delete: if hasFullAccess();
    }

    match /volunteer_logs/{document=**} {
      allow read, write: if hasFullAccess();
    }

    match /program_templates/{document=**} {
      allow read, write: if hasFullAccess();
    }

    match /report_schedules/{document=**} {
      allow read, write: if hasFullAccess();
    }

    match /volunteer_organizations/{orgId} {
      allow read, update: if hasFullAccess() || isOrgMember(orgId);
      allow create, delete: if hasFullAccess();
    }

    match /organizations/{orgId} {
      allow read: if hasFullAccess() || isOrgAdmin(orgId) || isOrgMember(orgId);
      allow update: if hasFullAccess() || isOrgMember(orgId);
      allow create, delete: if hasFullAccess();

      match /orgAdmins/{adminId} {
        allow read: if isSignedIn() && (request.auth.uid == adminId || isOrgAdmin(orgId));
        allow write: if false;
      }

      match /volunteers/{volunteerId} {
        allow read: if isSignedIn() && (request.auth.uid == volunteerId || isOrgAdmin(orgId));
        allow create: if isSignedIn() && request.auth.uid == volunteerId;
        allow update: if isOrgAdmin(orgId);
        allow delete: if false;
      }

      match /threads/{threadId} {
        allow read: if isOrgAdmin(orgId) || (isSignedIn() && request.auth.uid in resource.data.participantIds);
        allow create, update: if isOrgAdmin(orgId);

        match /messages/{messageId} {
          allow read: if isOrgAdmin(orgId) || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)/threads/$(threadId)).data.participantIds);
          allow create: if isSignedIn() && (isOrgAdmin(orgId) || request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)/threads/$(threadId)).data.participantIds);
        }
      }

      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOrgAdmin(orgId);

        match /shifts/{shiftId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isOrgAdmin(orgId);
        }

        match /registrations/{regId} {
          allow read: if isOrgAdmin(orgId) || (isSignedIn() && request.auth.uid == regId);
          allow create, update: if isSignedIn() && request.auth.uid == regId;
          allow delete: if isOrgAdmin(orgId);
        }
      }

      match /hourLogs/{logId} {
        allow read: if isOrgAdmin(orgId) || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      match /checkIns/{sessionId} {
        allow read: if isOrgAdmin(orgId) || (isSignedIn() && resource.data.userId == request.auth.uid);
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if false;
      }

    }

    // Collection-group rule for querying an admin's own orgAdmins membership(s)
    // across all orgs (used by resolveOrgAdminContext/subscribeToOrgAdminContext).
    // Nested `match` rules under /organizations/{orgId}/orgAdmins do not reliably
    // apply to collectionGroup() list queries that aren't scoped to a single known
    // orgId, so this needs its own top-level, path-wildcard rule.
    // Depends on the invariant that every orgAdmins doc's ID equals its own
    // `userId` field (true for every current writer of this collection) — if
    // that ever diverges, this list rule and the nested get/read rule above it
    // would authorize different things for the same document.
    match /{path=**}/orgAdmins/{adminId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Collection-group rule for a volunteer querying their own org membership(s)
    // across all orgs (used by OrgsService.fetchMembershipsForUser/observeMemberships,
    // which back EventsView's "my orgs" discovery). Same rationale as the orgAdmins
    // rule above: nested match rules under /organizations/{orgId}/volunteers don't
    // apply to collectionGroup() list queries. Depends on the same invariant: every
    // volunteers doc's ID equals its own `userId` field.
    match /{path=**}/volunteers/{volunteerId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /joinCodes/{code} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /publicOrgPages/{orgId} {
      allow read: if true;
      allow write: if false;

      match /events/{eventId} {
        allow read: if true;
        allow write: if isOrgAdmin(orgId);
      }
    }

    match /orgs/{orgId} {
      allow read: if hasFullAccess() || isOrgMember(orgId);
      allow update: if hasFullAccess() || isOrgMember(orgId);
      allow create, delete: if hasFullAccess();
    }

    match /events/{eventId} {
      allow read: if isSignedIn() && isOrgMember(docOrgId(resource.data));
      allow create: if hasFullAccess() && isOrgMember(docOrgId(request.resource.data));
      allow update, delete: if hasFullAccess() && isOrgMember(docOrgId(resource.data));
    }

    match /kiosk_sessions/{sessionId} {
      allow read: if hasFullAccess() && isOrgMember(docOrgId(resource.data));
      allow create: if hasFullAccess() && isOrgMember(docOrgId(request.resource.data));
      allow update, delete: if hasFullAccess() && isOrgMember(docOrgId(resource.data));
    }

    match /nebulae_chats/{chatId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
